uniform sampler2D s_bloom;

struct v2p
{
    float2 tc0 : TEXCOORD0;
    float2 tc1 : TEXCOORD1;
    float2 tc2 : TEXCOORD2;
    float2 tc3 : TEXCOORD3;
};

float4 main(v2p I) : COLOR0
{
    return (tex2D(s_bloom, I.tc0) + tex2D(s_bloom, I.tc1) +
        tex2D(s_bloom, I.tc2) + tex2D(s_bloom, I.tc3)) * 0.25;
}
