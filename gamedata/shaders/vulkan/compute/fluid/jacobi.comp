#version 450
// 3D Fluid Jacobi Pressure Solver
// Iteratively solves Poisson equation: ∇²p = div(v)

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

// Input textures
layout(set = 0, binding = 0) uniform sampler3D pressureTex;    // Current pressure estimate
layout(set = 0, binding = 1) uniform sampler3D divergenceTex;  // Divergence field

// Output texture
layout(set = 0, binding = 2, r16f) writeonly uniform image3D pressureOut;

// Parameters
layout(push_constant) uniform Params {
    float alpha;     // -1.0 (coefficient for Laplacian)
    float rBeta;     // Reciprocal beta (1/6 for 3D)
    float padding1;
    float padding2;
} params;

void main() {
    uvec3 id = gl_GlobalInvocationID;
    uvec3 gridSize = imageSize(pressureOut);

    if (any(greaterThanEqual(id, gridSize))) {
        return;
    }

    vec3 cellSize = 1.0 / vec3(gridSize);
    vec3 uvw = (vec3(id) + 0.5) / vec3(gridSize);

    // Sample pressure at 6 neighbors
    float pL = texture(pressureTex, uvw - vec3(cellSize.x, 0.0, 0.0)).r;
    float pR = texture(pressureTex, uvw + vec3(cellSize.x, 0.0, 0.0)).r;
    float pD = texture(pressureTex, uvw - vec3(0.0, cellSize.y, 0.0)).r;
    float pU = texture(pressureTex, uvw + vec3(0.0, cellSize.y, 0.0)).r;
    float pB = texture(pressureTex, uvw - vec3(0.0, 0.0, cellSize.z)).r;
    float pF = texture(pressureTex, uvw + vec3(0.0, 0.0, cellSize.z)).r;

    // Sample divergence
    float divergence = texture(divergenceTex, uvw).r;

    // Jacobi iteration: p_new = (pL + pR + pD + pU + pB + pF + alpha * divergence) * rBeta
    float pressure = (pL + pR + pD + pU + pB + pF + params.alpha * divergence) * params.rBeta;

    imageStore(pressureOut, ivec3(id), vec4(pressure, 0.0, 0.0, 0.0));
}
