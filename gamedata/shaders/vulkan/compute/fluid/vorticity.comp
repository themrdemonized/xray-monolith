#version 450
// 3D Fluid Vorticity Computation
// Computes curl (vorticity) of velocity field: ω = ∇ × v

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

// Input
layout(set = 0, binding = 0) uniform sampler3D velocityTex;

// Output
layout(set = 0, binding = 1, rgba16f) writeonly uniform image3D vorticityOut;

void main() {
    uvec3 id = gl_GlobalInvocationID;
    uvec3 gridSize = imageSize(vorticityOut);

    if (any(greaterThanEqual(id, gridSize))) {
        return;
    }

    // Cell size in texture space
    vec3 cellSize = 1.0 / vec3(gridSize);

    // Normalized coordinates
    vec3 uvw = (vec3(id) + 0.5) / vec3(gridSize);

    // Sample velocity at neighbors (central differences)
    vec3 vL = texture(velocityTex, uvw - vec3(cellSize.x, 0.0, 0.0)).xyz;
    vec3 vR = texture(velocityTex, uvw + vec3(cellSize.x, 0.0, 0.0)).xyz;
    vec3 vD = texture(velocityTex, uvw - vec3(0.0, cellSize.y, 0.0)).xyz;
    vec3 vU = texture(velocityTex, uvw + vec3(0.0, cellSize.y, 0.0)).xyz;
    vec3 vB = texture(velocityTex, uvw - vec3(0.0, 0.0, cellSize.z)).xyz;
    vec3 vF = texture(velocityTex, uvw + vec3(0.0, 0.0, cellSize.z)).xyz;

    // Compute curl: ω = ∇ × v
    // ω.x = ∂v_z/∂y - ∂v_y/∂z
    // ω.y = ∂v_x/∂z - ∂v_z/∂x
    // ω.z = ∂v_y/∂x - ∂v_x/∂y

    vec3 vorticity;
    vorticity.x = (vF.y - vB.y) - (vU.z - vD.z);
    vorticity.y = (vR.z - vL.z) - (vF.x - vB.x);
    vorticity.z = (vU.x - vD.x) - (vR.y - vL.y);

    // Scale by cell size (central difference denominator is 2*h)
    vorticity *= 0.5 / cellSize;

    imageStore(vorticityOut, ivec3(id), vec4(vorticity, 0.0));
}
