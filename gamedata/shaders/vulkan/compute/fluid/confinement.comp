#version 450
// 3D Fluid Vorticity Confinement
// Applies confinement force to preserve vorticity: F = ε * (N × ω)

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

// Input textures
layout(set = 0, binding = 0) uniform sampler3D velocityTex;   // Current velocity
layout(set = 0, binding = 1) uniform sampler3D vorticityTex;  // Vorticity field

// Output texture
layout(set = 0, binding = 2, rgba16f) writeonly uniform image3D velocityOut;

// Parameters
layout(push_constant) uniform Params {
    float timeStep;       // Delta time
    float epsilon;        // Confinement scale (0.03-0.12)
    float padding1;
    float padding2;
} params;

void main() {
    uvec3 id = gl_GlobalInvocationID;
    uvec3 gridSize = imageSize(velocityOut);

    if (any(greaterThanEqual(id, gridSize))) {
        return;
    }

    vec3 cellSize = 1.0 / vec3(gridSize);
    vec3 uvw = (vec3(id) + 0.5) / vec3(gridSize);

    // Sample vorticity magnitude at neighbors
    float omegaL = length(texture(vorticityTex, uvw - vec3(cellSize.x, 0.0, 0.0)).xyz);
    float omegaR = length(texture(vorticityTex, uvw + vec3(cellSize.x, 0.0, 0.0)).xyz);
    float omegaD = length(texture(vorticityTex, uvw - vec3(0.0, cellSize.y, 0.0)).xyz);
    float omegaU = length(texture(vorticityTex, uvw + vec3(0.0, cellSize.y, 0.0)).xyz);
    float omegaB = length(texture(vorticityTex, uvw - vec3(0.0, 0.0, cellSize.z)).xyz);
    float omegaF = length(texture(vorticityTex, uvw + vec3(0.0, 0.0, cellSize.z)).xyz);

    // Gradient of vorticity magnitude (normalized direction)
    vec3 gradOmega = vec3(
        (omegaR - omegaL),
        (omegaU - omegaD),
        (omegaF - omegaB)
    ) * 0.5;

    // Normalize gradient (N vector)
    float len = length(gradOmega);
    if (len < 0.0001) {
        // No gradient - just copy velocity
        vec3 velocity = texture(velocityTex, uvw).xyz;
        imageStore(velocityOut, ivec3(id), vec4(velocity, 0.0));
        return;
    }

    vec3 N = gradOmega / len;

    // Current vorticity vector
    vec3 omega = texture(vorticityTex, uvw).xyz;

    // Confinement force: F = ε * (N × ω)
    vec3 force = params.epsilon * cross(N, omega);

    // Apply force to velocity
    vec3 velocity = texture(velocityTex, uvw).xyz;
    velocity += force * params.timeStep;

    imageStore(velocityOut, ivec3(id), vec4(velocity, 0.0));
}
