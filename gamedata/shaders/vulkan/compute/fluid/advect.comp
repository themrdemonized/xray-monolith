#version 450
// 3D Fluid Advection Shader - Semi-Lagrangian Transport
// Transports scalar field (density/temperature) by velocity field

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

// Input textures
layout(set = 0, binding = 0) uniform sampler3D velocityTex;  // Current velocity field
layout(set = 0, binding = 1) uniform sampler3D scalarTex;    // Field to advect (density/temp)

// Output texture
layout(set = 0, binding = 2, rgba16f) writeonly uniform image3D scalarOut;

// Parameters
layout(push_constant) uniform Params {
    float timeStep;      // Delta time
    float dissipation;   // Decay factor (0.994-0.9995)
    float forward;       // Direction (+1.0 forward, -1.0 backward for BFECC)
    float padding;
} params;

void main() {
    uvec3 id = gl_GlobalInvocationID;
    uvec3 gridSize = imageSize(scalarOut);

    // Bounds check
    if (any(greaterThanEqual(id, gridSize))) {
        return;
    }

    // Normalized coordinates [0, 1]
    vec3 uvw = (vec3(id) + 0.5) / vec3(gridSize);

    // Sample velocity at current position
    vec3 velocity = texture(velocityTex, uvw).xyz;

    // Backtrace along velocity (Semi-Lagrangian)
    // For forward advection: look backward in time
    // For BFECC backward: look forward in time
    vec3 uvwPrev = uvw - (velocity * params.timeStep * params.forward);

    // Clamp to texture boundaries
    uvwPrev = clamp(uvwPrev, vec3(0.0), vec3(1.0));

    // Sample scalar field at previous position (linear interpolation)
    float scalar = texture(scalarTex, uvwPrev).r;

    // Apply dissipation/decay
    scalar *= params.dissipation;

    // Write result
    imageStore(scalarOut, ivec3(id), vec4(scalar, 0.0, 0.0, 0.0));
}
