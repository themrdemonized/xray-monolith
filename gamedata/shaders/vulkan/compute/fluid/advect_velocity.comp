#version 450
// 3D Fluid Velocity Advection Shader
// Transports velocity field by itself (self-advection)

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

// Input textures
layout(set = 0, binding = 0) uniform sampler3D velocityTex;  // Current velocity field

// Output texture
layout(set = 0, binding = 1, rgba16f) writeonly uniform image3D velocityOut;

// Parameters
layout(push_constant) uniform Params {
    float timeStep;         // Delta time
    float dissipation;      // Decay factor
    float gravityBuoyancy;  // Buoyancy force (positive = up)
    float padding;
} params;

void main() {
    uvec3 id = gl_GlobalInvocationID;
    uvec3 gridSize = imageSize(velocityOut);

    if (any(greaterThanEqual(id, gridSize))) {
        return;
    }

    // Normalized coordinates
    vec3 uvw = (vec3(id) + 0.5) / vec3(gridSize);

    // Sample current velocity
    vec3 velocity = texture(velocityTex, uvw).xyz;

    // Backtrace (Semi-Lagrangian)
    vec3 uvwPrev = uvw - velocity * params.timeStep;
    uvwPrev = clamp(uvwPrev, vec3(0.0), vec3(1.0));

    // Sample velocity at previous position
    vec3 advectedVelocity = texture(velocityTex, uvwPrev).xyz;

    // Apply dissipation
    advectedVelocity *= params.dissipation;

    // Apply buoyancy (vertical force)
    advectedVelocity.y += params.gravityBuoyancy * params.timeStep;

    // Write result
    imageStore(velocityOut, ivec3(id), vec4(advectedVelocity, 0.0));
}
