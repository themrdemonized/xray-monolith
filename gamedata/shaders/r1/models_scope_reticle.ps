// First lightweight prototype: ordinary ACOG, two texture samples, no optional visual effects.
uniform sampler2D s_base;
uniform sampler2D s_scene;
uniform float4 s3ds_param_1;
uniform float4 s3ds_param_2;
uniform float4 m_hud_params;
uniform float4 markswitch_color;
uniform float4 screen_res;
uniform float4 r1_scope_debug;

struct vf
{
    float2 tc : TEXCOORD0;
    float4 screen : TEXCOORD1;
    float3 eye : TEXCOORD2;
    float3 tangent : TEXCOORD3;
    float3 binormal : TEXCOORD4;
};

float4 main(vf I) : COLOR0
{
    float3 eye = normalize(I.eye);
    float2 parallax = float2(dot(eye, I.tangent), dot(eye, I.binormal));
    float aim = saturate(m_hud_params.x);
    float zoom = lerp(1.0, 0.2 * max(s3ds_param_2.w, 1.0) + 0.8, aim);
    float shift = (0.8 * max(s3ds_param_2.w, 1.0) - 0.8) * aim;
    float2 screen_tc = I.screen.xy / I.screen.w * float2(0.5, -0.5) + 0.5;
    float2 scene_tc = (screen_tc - 0.5) / zoom + 0.5 + screen_res.zw * 0.5;
    scene_tc += parallax * float2(screen_res.y / screen_res.x, 1.0) * shift;
    float3 color = tex2D(s_scene, scene_tc).rgb;

    float size = max(s3ds_param_1.x, 0.001);
    float2 reticle_tc = (I.tc - 0.5 - parallax * 10.0) / size + 0.5;
    float4 mark = tex2D(s_base, reticle_tc);
    // GAMMA's ACOG stores black lines, illumination and text in R, G and B.
    color = lerp(color, 0.0, mark.r);
    color = lerp(color, markswitch_color.rgb, mark.g);
    color = lerp(color, 0.3, mark.b);

    float pupil = max(s3ds_param_1.z * aim, 0.001);
    float2 exit_tc = (I.tc - 0.5 + parallax * s3ds_param_1.y) / pupil;
    float visible = saturate((0.5 - length(exit_tc)) / 0.15);
    float3 result = color * visible;
    float surface_debug = saturate(r1_scope_debug.x);
    result = lerp(result, float3(1.0, 0.0, 1.0), surface_debug);
    return float4(result, 1.0);
}
