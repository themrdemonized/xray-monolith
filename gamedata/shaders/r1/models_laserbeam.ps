uniform sampler2D s_base;
uniform float4 shader_param_6;

struct v2p
{
    float2 tc0 : TEXCOORD0;
    float4 c0 : COLOR0;
};

float4 main(v2p I) : COLOR0
{
    float4 color = tex2D(s_base, I.tc0);
    float hue = frac((shader_param_6.z - 1.0) / 99.0);
    float3 tint = saturate(float3(abs(hue * 6.0 - 3.0) - 1.0,
        2.0 - abs(hue * 6.0 - 2.0), 2.0 - abs(hue * 6.0 - 4.0)));
    float intensity = dot(color.rgb, float3(0.299, 0.587, 0.114));
    color.rgb = lerp(color.rgb, tint * intensity, shader_param_6.z > 0.5);
    color *= abs(shader_param_6.y) * 1.5;
    color.a *= I.c0.a;
    return color;
}
