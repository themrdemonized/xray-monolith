#include "common.h"
#include "sload.h"

static const float BRIGHTNESS = 0.17f;
static const float CONTRAST = 1.30f;

float3 adjust_brightness_contrast(float3 color)
{
	return saturate((color - 0.5f) * CONTRAST + 0.5f + BRIGHTNESS);
}

float4 main (p_bumped I) : SV_TARGET
{
	float4 color = s_base.Sample(smp_base, I.tcdh.xy);
	color.rgb = adjust_brightness_contrast(color.rgb);
	return color;
}
