// near-field defocus on the SVP scope image, golden-angle spiral bokeh gather after Gustafsson
// (blog.voxagon.se), uniform sample density, near-field-only circle of confusion
#include "common.h"

Texture2D s_nb_image;
Texture2D s_nb_pos;

uniform float4 svp_nearblur_params; // x focus-far m, y full-blur m, z max radius px, w strength

#define NB_GOLDEN_ANGLE 2.39996323f

float nb_depth(float2 uv)
{
	float z = s_nb_pos.SampleLevel(smp_nofilter, uv, 0).z;
	return (z < 0.02f) ? 10000.0f : z; // unwritten gbuffer (sky) counts as far, stays sharp
}

float nb_size(float z) // blur disc radius in px, near field only
{
	float c = saturate((svp_nearblur_params.x - z) / max(svp_nearblur_params.x - svp_nearblur_params.y, 0.01f));
	return c * c * svp_nearblur_params.z;
}

float4 main(p_screen I, float4 pos2d : SV_POSITION) : SV_Target
{
	float2 uv = pos2d.xy * screen_res.zw;
	float centerDepth = nb_depth(uv);
	float centerSize = nb_size(centerDepth);
	float3 base = s_nb_image.SampleLevel(smp_base, uv, 0).rgb;

	float maxR = svp_nearblur_params.z;
	// keep the spiral around 150 taps whatever the radius, iterations ~ maxR^2 / (2*rad_scale)
	float rad_scale = max(0.5f, maxR * maxR / 300.0f);

	float3 color = base;
	float tot = 1.0f;
	float radius = rad_scale;
	[loop]
	for (float ang = 0.0f; radius < maxR && ang < 400.0f; ang += NB_GOLDEN_ANGLE)
	{
		float2 tc = uv + float2(cos(ang), sin(ang)) * screen_res.zw * radius;
		float sampleDepth = nb_depth(tc);
		float sampleSize = nb_size(sampleDepth);
		if (sampleDepth > centerDepth)
			sampleSize = clamp(sampleSize, 0.0f, centerSize * 2.0f);
		float m = smoothstep(radius - 0.5f, radius + 0.5f, sampleSize);
		float3 sampleColor = s_nb_image.SampleLevel(smp_base, tc, 0).rgb;
		color += lerp(color / tot, sampleColor, m);
		tot += 1.0f;
		radius += rad_scale / radius;
	}
	color /= tot;
	return float4(lerp(base, color, saturate(svp_nearblur_params.w)), 1.0f);
}
