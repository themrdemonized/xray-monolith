; Minimal system.ltx for Vulkan renderer testing

[startup]
$tut$ = false

[help]
help_enable = off

[game_relations]
rating_kill = off

[device]
r__supersample = 1

[render]
r2_sun = on
r2_sun_shafts = off

[sound]
snd_acceleration = on

[ai]
ai_obstacles_enabled = off

[console]
con_list_file = con_list.ltx
