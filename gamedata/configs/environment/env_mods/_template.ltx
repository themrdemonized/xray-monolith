; Copy into configs\environment\env_mods\<level>.ltx, see docs\env_mods.md
; All fields except use_flags are required

[modifier_example]
position    = 0, 0, 0           ; centre of the sphere
radius      = 50                ; metres
power       = 100               ; strength at the centre, falls to 0 at radius
far_plane   = 150               ; view distance
fog_color   = 0.5, 0.5, 0.5     ; r, g, b
fog_density = 0.7
ambient     = 0.1, 0.1, 0.1     ; r, g, b
sky_color   = 0.5, 0.5, 0.5     ; r, g, b
hemi_color  = 1, 1, 1           ; r, g, b
use_flags   = 0x3F              ; optional, sum of: 0x01 far_plane, 0x02 fog_color, 0x04 fog_density, 0x08 ambient, 0x10 sky_color, 0x20 hemi_color
