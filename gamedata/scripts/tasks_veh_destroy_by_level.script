local base_veh_destroy_sf

local function veh_destroy_sf(tsk, task_id)
	local level_name = task_id and task_manager.task_ini:r_string_ex(task_id, "level")
	if not level_name then
		return base_veh_destroy_sf(tsk, task_id)
	end
	return level_placement.on_level(level_name, base_veh_destroy_sf, tsk, task_id)
end

function on_game_start()
	if not tasks_veh_destroy then
		return
	end
	base_veh_destroy_sf = task_status_functor.veh_destroy_sf
	task_status_functor.veh_destroy_sf = veh_destroy_sf
end
