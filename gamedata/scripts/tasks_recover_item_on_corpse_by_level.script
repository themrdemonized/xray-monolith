-- level_coordinate_N overrides level_name for one coordinate.

local base_parse_settings

local function parse_settings(task_id)
	local settings = base_parse_settings(task_id)
	if type(settings) ~= "table" then
		return settings
	end
	for key, value in pairs(settings) do
		if type(value) == "string" and key:find("^coordinate_") then
			local level_name = settings["level_" .. key] or settings.level_name
			if level_name then
				settings[key] = level_placement.resolve_string(value, level_name)
			end
		end
	end
	return settings
end

function on_game_start()
	base_parse_settings = tasks_recover_item_on_corpse.parse_settings
	tasks_recover_item_on_corpse.parse_settings = parse_settings
end
