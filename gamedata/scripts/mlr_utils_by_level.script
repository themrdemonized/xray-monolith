local base_change_lvl, base_spawn_item

local function change_lvl(p)
	local clt = mlr_utils.CLT
	local t = clt and clt[p]
	if t and CLT_LEVELS[p] and not level_placement.resolve(t, CLT_LEVELS[p]) then
		return
	end
	return base_change_lvl(p)
end

local function spawn_item(name)
	local spwn = mlr_utils.SPWN
	local items = spwn and spwn[name]
	if items and SPWN_LEVELS[name] then
		for _, t in pairs(items) do
			if not level_placement.resolve(t, SPWN_LEVELS[name]) then
				return
			end
		end
	end
	return base_spawn_item(name)
end

function on_game_start()
	base_change_lvl, base_spawn_item = mlr_utils.change_lvl, mlr_utils.spawn_item
	mlr_utils.change_lvl, mlr_utils.spawn_item = change_lvl, spawn_item
end
