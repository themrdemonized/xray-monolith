COMPILER_OPTS = {
   correlate = true,
   env = "_COMPILER",
   useBitLib = true,
   ["error-pinpoint"] = false,
}

function compile(src, namespace_name)
   return function()
      local macros = fennel.eval(
         src,
         COMPILER_OPTS
      )

      package.loaded[namespace_name] = macros
      fennel["macro-loaded"][namespace_name] = macros
   end
end
