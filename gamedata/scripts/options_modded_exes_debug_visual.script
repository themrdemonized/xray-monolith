	get_item_if_exists(check { id = "dbg_ph_shapes", def = false }),
	get_item_if_exists(check { id = "dbg_ph_bones", def = false }),
	get_item_if_exists(check { id = "dbg_vis_boxes", def = false }),
	get_item_if_exists(check { id = "dbg_attachment_cforms", def = false }),
	get_item_if_exists(check { id = "rs_render_portals", def = false }),
	get_item_if_exists(list_bool { id = "r__portal_traverse_stats", def = "0" }),
})
