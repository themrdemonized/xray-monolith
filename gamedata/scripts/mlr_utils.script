function spawn_item(name)
	local tbl = SPWN[name]
	for k, v in pairs(tbl) do
		local pos = vector():set(v[1], v[2], v[3])
		local lvid, gvid = level_placement.vertices(v.level, pos)
		if lvid then
			for i = 1, (v[4] or 1) do 
				alife_create(k, pos, lvid, gvid)
			end
		end
	end
end

function change_lvl(p)
	if db.actor:is_talking() then
		db.actor:stop_talk()
	end
	local pos = vector():set(CLT[p][1], CLT[p][2], CLT[p][3])
	local lvid, gvid = level_placement.vertices(CLT[p].level, pos)
	if lvid then
		ChangeLevel(pos, lvid, gvid, vector():set(CLT[p][4] or 0, CLT[p][5] or 0, CLT[p][6] or 0), true)
	end
end

function have_item(sect, needed)
	if not needed then
		needed = 1
	end
	local avail = utils_item.get_amount(db.actor, sect, 1)
	return (avail >= needed)
end

function have_money(count)
	return db.actor:money() >= count
end

function get_cost_sect(section, count)
    local cost = ini_sys:r_s32(section, 'cost')
    return cost and cost * (count or 1)
end

function save_var(key_1, key_2, key_3)
	if (not alife_storage_manager.get_state()['mlr']) then
		alife_storage_manager.get_state()['mlr'] = {}
	end
	if key_3 then
		alife_storage_manager.get_state()['mlr'][key_1] = {}
		alife_storage_manager.get_state()['mlr'][key_1][key_2] = key_3
	else
		alife_storage_manager.get_state()['mlr'][key_1] = key_2
	end
end

function load_var(key_1, key_2)
	if not alife_storage_manager.get_state()['mlr'] then
		return
	end
	if key_2 then
		if (not alife_storage_manager.get_state()['mlr'][key_1]) then
			return
		end
		return alife_storage_manager.get_state()['mlr'][key_1][key_2]
	end
	return alife_storage_manager.get_state()['mlr'][key_1]
end

function death_heli(obj, enemy_id)
		local heli_pos = obj:position()
		local heli_id = obj:id()
		local drop = alife_create('blackbox_mlr',heli_pos,obj:level_vertex_id(),obj:game_vertex_id())
end

function give_task(name)
    task_manager.get_task_manager():give_task(name)
end