local base_init_settings
local resolved = false

-- [position name] = level (its section under [levels])
local function position_levels()
	local ini = ini_file("items\\settings\\dynamic_item_spawn.ltx")
	local result = {}
	local n = ini:line_count("levels") or 0
	for i = 0, n - 1 do
		local _, level_name = ini:r_line_ex("levels", i, "", "")
		local m = level_name and ini:section_exist(level_name) and ini:line_count(level_name) or 0
		for j = 0, m - 1 do
			local _, name = ini:r_line_ex(level_name, j, "", "")
			if name then
				result[name] = level_name
			end
		end
	end
	return result
end

local function resolve()
	local info, off = game_setup.world_itm_info, game_setup.world_itm_off
	if not (info and off) then
		printf("! [dynamic_items_by_level] game_setup.world_itm_info/world_itm_off missing (unlocalizer_coord_placement.ltx), positions left as recorded")
		return
	end

	local levels = position_levels()
	local changed, unchanged, dropped = 0, 0, 0
	for name, t in pairs(info) do
		local lvid, gvid = level_placement.vertices(levels[name], vector():set(t.x, t.y, t.z))
		if not lvid then
			info[name] = nil
			off[name] = nil
			dropped = dropped + 1
		elseif lvid == t.lvl_id and gvid == t.gm_id then
			unchanged = unchanged + 1
		else
			t.lvl_id, t.gm_id = lvid, gvid
			changed = changed + 1
		end
	end
	printf("* [dynamic_items_by_level] positions: %s placed by level and position (%s differ from the recorded ids), %s dropped (level not in the game graph)", changed + unchanged, changed, dropped)
end

local function init_settings(...)
	base_init_settings(...)
	if resolved then
		return
	end
	resolved = true
	resolve()
end

function on_game_start()
	base_init_settings = game_setup.init_settings
	game_setup.init_settings = init_settings
end
