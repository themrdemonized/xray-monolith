-- The position string is rewritten where it is read: its ids also go to squad:create_npc, which on_level does
-- not cover.

local base_create_squad_at_named_location

local function create_squad_at_named_location(self, loc_name, squad_id)
	local ini = ini_file("named_locations.ltx")
	local level_name = loc_name and ini:section_exist(loc_name) and ini:r_string_ex(loc_name, "level")
	if not level_name then
		return base_create_squad_at_named_location(self, loc_name, squad_id)
	end

	local base_read = utils_data.read_from_ini
	local function read_from_ini(i, section, line, ...)
		local value = base_read(i, section, line, ...)
		if section == loc_name and line == "position" and type(value) == "string" then
			value = level_placement.resolve_string(value, level_name)
		end
		return value
	end
	return level_placement.with(utils_data, "read_from_ini", read_from_ini, base_create_squad_at_named_location, self, loc_name, squad_id)
end

function on_game_start()
	base_create_squad_at_named_location = sim_board.simulation_board.create_squad_at_named_location
	sim_board.simulation_board.create_squad_at_named_location = create_squad_at_named_location
end
