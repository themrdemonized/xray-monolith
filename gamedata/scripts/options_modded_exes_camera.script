--- Camera options tree

-- Import smart constructors
options_builder.import_into(this)

PAGE = page {
	{ id = "camera" },
	track {
		id = "freelook_cam_limit",
		def = math.pi / 2,
		step = 0.01,
	},
	list_bool { id = "freelook_while_reloading", def = "1" },
	track {
		id = "cam_attached_fov",
		def = 1,
		step = 0.01,
	},
}
