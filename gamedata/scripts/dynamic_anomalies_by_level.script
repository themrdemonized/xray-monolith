local base_ini_settings
local resolved = false

local function resolve()
	local info = bind_anomaly_field.dyn_ano_info
	if not info then
		printf("! [dynamic_anomalies_by_level] bind_anomaly_field.dyn_ano_info missing (unlocalizer_coord_placement.ltx), positions left as recorded")
		return
	end

	local changed, unchanged, dropped = 0, 0, 0
	for level_name, anomalies in pairs(info) do
		for name, t in pairs(anomalies) do
			local lvid, gvid = level_placement.vertices(level_name, vector():set(t.x, t.y, t.z))
			if not lvid then
				anomalies[name] = nil
				dropped = dropped + 1
			elseif lvid == t.lvl_id and gvid == t.gm_id then
				unchanged = unchanged + 1
			else
				t.lvl_id, t.gm_id = lvid, gvid
				changed = changed + 1
			end
		end
	end
	printf("* [dynamic_anomalies_by_level] positions: %s placed by level and position (%s differ from the recorded ids), %s dropped (level not in the game graph)", changed + unchanged, changed, dropped)
end

local function ini_settings(...)
	base_ini_settings(...)
	if resolved then
		return
	end
	resolved = true
	resolve()
end

function on_game_start()
	base_ini_settings = bind_anomaly_field.ini_settings
	bind_anomaly_field.ini_settings = ini_settings
end
