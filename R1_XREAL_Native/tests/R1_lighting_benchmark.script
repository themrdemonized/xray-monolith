local ffi,kernel,dll,frame
local actor_at=nil
local start,phase,at,last_frame,first_frame,updates=nil,0,0,0,0,0
local app=getFS():update_path('$app_data_root$','')
local names={'mono_wide','stereo_normal','stereo_no_local_shadows','stereo_restored'}
local function log(s)local f=assert(io.open(app..'R1_lighting_benchmark.log','ab'));f:write(s..'\n');f:close()end
local function tick()
 if not db.actor then return end
 actor_at=actor_at or time_global();if time_global()-actor_at<3000 then return end
 if not ffi then
  r1_xreal_native.prepare_menu()
  ffi=require('ffi');ffi.cdef[[void* GetModuleHandleA(const char*);unsigned long long GetTickCount64();int r1st_probe_shadows(unsigned);int r1st_capture(const char*);]]
  kernel=ffi.load('kernel32');dll=ffi.load(getFS():update_path('$game_data$','plugins\\R1_XREAL_Native\\R1_XREAL_Native.dll'))
  frame=ffi.cast('unsigned*',ffi.cast('unsigned char*',kernel.GetModuleHandleA(nil))+0x15d0ee0+40)
  start=tonumber(kernel.GetTickCount64());at=start;phase=1;log('START exact-host isolated benchmark')
 end
 local now=tonumber(kernel.GetTickCount64())
 if now-start>90000 then log('FAIL timeout');exec_console_cmd('quit');return end
 local elapsed=now-at
 if elapsed<4000 then first_frame=tonumber(frame[0]);last_frame=now;updates=0;return end
 updates=updates+1
 if elapsed<14000 then return end
 log(string.format('%s frames=%d elapsed_ms=%d fps=%.3f updates=%d',names[phase],tonumber(frame[0])-first_frame,now-last_frame,(tonumber(frame[0])-first_frame)*1000/(now-last_frame),updates))
 if phase==1 then r1_xreal_native.toggle()
 elseif phase==2 then assert(dll.r1st_probe_shadows(1)==1)
 elseif phase==3 then assert(dll.r1st_probe_shadows(0)==1)
 else r1_xreal_native.stop();log('DONE process exit must also pass');exec_console_cmd('quit');return end
 phase=phase+1;at=now
end
function on_game_start()
 RegisterScriptCallback('actor_on_update',function()local ok,e=xpcall(tick,debug.traceback);if not ok then log('FAIL '..tostring(e));exec_console_cmd('quit')end end)
end
