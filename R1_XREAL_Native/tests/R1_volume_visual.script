local started,phase,at=nil,0,0
local ffi,dll,status
local app=getFS():update_path('$app_data_root$','')
local function log(s)local f=assert(io.open(app..'R1_volume_visual.log','ab'));f:write(s..'\n');f:close()end
local function tick()
 if not db.actor then return end
 if not started then log('ACTOR_CALLBACK '..time_global()) end
 local now=time_global()/1000;started=started or now
 if now-started>45 then log('FAIL timeout');exec_console_cmd('quit');return end
 if phase==0 and now-started>3 then
  r1_xreal_native.toggle()
  ffi=require('ffi');ffi.cdef('int r1st_capture(const char*);')
  dll=ffi.load(getFS():update_path('$game_data$','plugins\\R1_XREAL_Native\\R1_XREAL_Native.dll'))
  status=ffi.new('R1XrealStatus[1]');status[0].size=ffi.sizeof('R1XrealStatus')
  phase=1;at=now
 elseif phase==1 and now-at>3 then
  assert(dll.r1st_status(status)==1 and status[0].pairs>10 and status[0].error==0)
  assert(dll.r1st_capture(app..'R1_volume_balanced.ppm')==1);log('BALANCED_CAPTURE');phase=2;at=now
 elseif phase==2 and now-at>1 then
  assert(dll.r1st_volume_quality(0)==1);phase=3;at=now
 elseif phase==3 and now-at>3 then
  assert(dll.r1st_capture(app..'R1_volume_original.ppm')==1);log('ORIGINAL_CAPTURE');phase=4;at=now
 elseif phase==4 and now-at>1 then
  assert(dll.r1st_volume_quality(1)==1);phase=5;at=now
 elseif phase==5 and now-at>3 then
  assert(dll.r1st_capture(app..'R1_volume_fast.ppm')==1);log('FAST_CAPTURE');phase=6;at=now
 elseif phase==6 and now-at>1 then
  assert(dll.r1st_status(status)==1 and status[0].error==0)
  log('PASS pairs='..tonumber(status[0].pairs)..' error='..tonumber(status[0].error))
  r1_xreal_native.stop();exec_console_cmd('quit');phase=7
 end
end
function on_game_start()
 log('REGISTER visual callback')
 RegisterScriptCallback('actor_on_update',function()local ok,e=xpcall(tick,debug.traceback);if not ok then log('FAIL '..tostring(e));exec_console_cmd('quit')end end)
end
