-- Isolated acceptance driver. Never installed by the engine/API package.
local phase, start_at, tick_at = 0, nil, 0
local a, b, drawing, last_x, last_y
local saved, reload_pending = nil, false
local annotations, input_events, visibility_events = {}, 0, 0
local automatic_step=0
local heartbeat_at=0
local screenshot_at,screenshot_command=0,nil
local function capture(command)
    screenshot_command=command; screenshot_at=time_continual()+600
end
local function out(text) printf("[R1PDATEST] "..text); flush() end
local function check(value, name) assert(value, name); out("PASS "..name) end
local function create_layers()
    check(pda_map and pda_map.version()==1 and pda_map.ready(), "native_api_registered")
    a=pda_map.register_layer("R1 PDA acceptance pencil")
    b=pda_map.register_layer("R1 PDA acceptance route")
    check(a~=0 and b~=0 and a~=b, "independent_layers")
    check(pda_map.register_layer("R1 PDA acceptance pencil")==0, "duplicate_owner_refused")
end
local function add_shape(token, screen_points, color, closed)
    local points={}
    for i,p in ipairs(screen_points) do
        local ok,x,y=pda_map.from_screen("global_map",p[1],p[2])
        check(ok,"unproject_"..i)
        points[#points+1]={x,y}
    end
    local id=pda_map.add_polyline(token,"global_map",points,4,color,closed)
    check(id~=0,"polyline_added")
    annotations[#annotations+1]={which=token==a and 1 or 2, points=points, color=color, closed=closed}
    return id
end
local function draw_fixture()
    local v=pda_map.viewport()
    out(string.format("FIXTURE ready=%s shown=%s width=%s height=%s",tostring(v.ready),tostring(v.shown),tostring(v.width),tostring(v.height)))
    check(v.ready and v.shown and v.width>100 and v.height>100,"actual_pda_viewport")
    local x,y,w,h=v.x,v.y,v.width,v.height
    add_shape(a,{{x+w*.25,y+h*.25},{x+w*.55,y+h*.25},{x+w*.55,y+h*.48},
        {x+w*.4,y+h*.63},{x+w*.25,y+h*.48}},0xffffc44d,true)
    add_shape(b,{{x+w*.15,y+h*.75},{x+w*.35,y+h*.66},{x+w*.65,y+h*.78},
        {x+w*.8,y+h*.55}},0xff32e0ff,false)
    local ok,mx,my=pda_map.from_screen("global_map",x+w*.7,y+h*.3)
    check(ok,"marker_projection")
    check(pda_map.add_marker(b,"global_map","ui_inGame2_white_rect",mx,my,18,18,0xfff86fa2,false)~=0,"atlas_marker_added")
    check(pda_map.add_marker(a,"global_map","R1_nonexistent_texture",mx,my,8,8,0xffffffff,false)==0,"missing_texture_refused")
    check(pda_map.add_polyline(a,"global_map",{{1,2},{3,"bad"}},2,0xffffffff,false)==0,"malformed_points_refused")
    check(pda_map.add_line(a,"R1_unknown_level",1,2,3,4,2,0xffffffff)==0,"unknown_map_refused")
    check(pda_map.add_line(a,"global_map",0/0,2,3,4,2,0xffffffff)==0,"nan_refused")
    local sx,sy=x+w*.4,y+h*.4
    local ok1,px,py=pda_map.from_screen("global_map",sx,sy)
    local ok2,rx,ry=pda_map.to_screen("global_map",px,py)
    check(ok1 and ok2 and math.abs(rx-sx)<.01 and math.abs(ry-sy)<.01,"live_global_roundtrip")
    local pos=db.actor:position()
    ok1,sx,sy=pda_map.to_screen(level.name(),pos.x,pos.z)
    ok2,rx,ry=pda_map.from_screen(level.name(),sx,sy)
    check(ok1 and ok2 and math.abs(rx-pos.x)<.01 and math.abs(ry-pos.z)<.01,"live_level_roundtrip")
    check(pda_map.acquire_input(a),"pencil_input_acquired")
    check(not pda_map.acquire_input(b),"second_input_owner_refused")
    check(not pda_map.release_input(b),"foreign_input_release_refused")
    out(string.format("VIEWPORT x=%.2f y=%.2f w=%.2f h=%.2f zoom=%.5f",v.x,v.y,v.width,v.height,v.zoom))
    check(pda_map.count(a)==1 and pda_map.count(b)==2,"layer_counts")
end
local function on_input(event)
    if event.layer~=a then return end
    input_events=input_events+1
    if event.action~="mouse_move" then out("INPUT "..event.action) end
    if event.shift then drawing,last_x,last_y=false,nil,nil; return end
    if event.action=="left_down" or event.action=="left_double_click" then
        drawing=true; last_x,last_y=event.global_x,event.global_y; event.consume=true
    elseif event.action=="left_up" then
        drawing,last_x,last_y=false,nil,nil; event.consume=true
    elseif event.action=="mouse_move" and drawing then
        if not event.left_held then drawing,last_x,last_y=false,nil,nil; return end
        if last_x and event.global_x then
            local id=pda_map.add_line(a,"global_map",last_x,last_y,event.global_x,event.global_y,3,0xff7aff64)
            check(id~=0,"input_line_added")
            last_x,last_y=event.global_x,event.global_y
        end
        event.consume=true
    end
end
local function on_visibility(shown)
    visibility_events=visibility_events+1
    out("VISIBILITY "..tostring(shown))
    if not shown then drawing,last_x,last_y=false,nil,nil end
end
local function on_load(storage)
    saved=storage.R1_pda_api_acceptance
    reload_pending=type(saved)=="table" and saved.schema==1
end
local function on_save(storage)
    if not a or not b then out("SAVE_STATE_BEFORE_FIXTURE"); return end
    storage.R1_pda_api_acceptance={schema=1,annotations=annotations,old_a=a,old_b=b}
    out("SAVE_STATE")
end
local function first_update()
    start_at=time_continual(); phase=0; tick_at=0; automatic_step=0
    exec_console_cmd("g_god on")
    exec_console_cmd("g_3d_pda off")
    exec_console_cmd("keypress_on_start off")
    device():pause(false)
    out("FIRST_UPDATE level="..level.name().." reload="..tostring(reload_pending))
end
local function update()
    if not start_at or not db.actor then return end
    local now=time_continual()
    if screenshot_command and now>=screenshot_at then
        exec_console_cmd(screenshot_command); screenshot_command=nil
    end
    if now>=heartbeat_at then
        heartbeat_at=now+5000
        out(string.format("HEARTBEAT phase=%d time=%d frame=%d paused=%s precache=%d",phase,now,device().frame,tostring(device():is_paused()),device().precache_frame))
    end
    if now<tick_at then return end
    tick_at=now+100
    if phase==0 and now-start_at>8000 then
        ActorMenu.get_pda_menu():SetActiveSubdialog("eptTasks")
        ActorMenu.get_pda_menu():ShowDialog(true)
        phase=1; start_at=now
    elseif phase==1 and now-start_at>2200 then
        -- The startup loading intro can close a dialog opened during first_update.
        -- Reopen only our test dialog after that lifecycle event, before asserting drawing.
        if not pda_map.viewport().shown then
            ActorMenu.get_pda_menu():SetActiveSubdialog("eptTasks")
            ActorMenu.get_pda_menu():ShowDialog(true)
            start_at=now
            out("WAIT_MAP_SHOWN")
            return
        end
        if reload_pending then
            check(not pda_map.valid_layer(saved.old_a) and not pda_map.valid_layer(saved.old_b),"old_tokens_invalid_after_load")
            create_layers(); annotations={}
            for _,row in ipairs(saved.annotations) do
                local id=pda_map.add_polyline(row.which==1 and a or b,"global_map",row.points,4,row.color,row.closed)
                check(id~=0,"annotation_rebuilt_from_save")
                annotations[#annotations+1]=row
            end
            check(pda_map.count(a)==1 and pda_map.count(b)==1,"restored_layer_counts")
            capture("screenshot R1_Pda_API_Reload")
            out("RELOAD_COMPLETE"); reload_pending=false
            phase=5; start_at=now
        else
            create_layers(); draw_fixture()
            phase=2; start_at=now
        end
    elseif phase==2 and now-start_at>1200 then
        capture("screenshot R1_Pda_API_Baseline")
        out("INTERACTIVE_READY")
        phase=3
    elseif phase==3 then
        local command=nil
        if now-start_at>2200 then
            automatic_step=automatic_step+1; start_at=now
            command=({[1]='clear',[2]='hide_show',[3]='save_reload'})[automatic_step]
        end
        if command=="input_done" then
            check(input_events>2 and pda_map.count(a)>1,"real_input_creates_commands")
            exec_console_cmd("screenshot R1_Pda_API_Input")
            out("INPUT_COMPLETE")
        elseif command=="clear" then
            check(pda_map.clear_layer(a),"pencil_clear")
            check(pda_map.count(a)==0 and pda_map.count(b)==2,"clear_keeps_other_layer")
            capture("screenshot R1_Pda_API_Clear")
            out("CLEAR_COMPLETE")
        elseif command=="hide_show" then
            check(pda_map.set_visible(b,false),"route_hide")
            check(pda_map.set_visible(b,true),"route_show")
            ActorMenu.get_pda_menu():HideDialog()
            check(pda_map.acquire_input(b)==false,"hidden_map_refuses_input")
            ActorMenu.get_pda_menu():ShowDialog(true)
            check(pda_map.acquire_input(b),"close_releases_old_input")
            check(pda_map.release_input(b) and pda_map.acquire_input(a),"input_can_switch_layers")
            check(visibility_events>=3,"visibility_callback_fired")
            out("HIDE_SHOW_COMPLETE")
        elseif command=="save_reload" then
            pda_map.clear_layer(a); pda_map.clear_layer(b); annotations={}
            draw_fixture()
            ActorMenu.get_pda_menu():HideDialog()
            exec_console_cmd("save R1_Pda_API_Verified")
            phase=4; start_at=now
        elseif command=="finish" then
            ActorMenu.get_pda_menu():HideDialog()
            check(pda_map.release_layer(a) and pda_map.release_layer(b),"layers_released")
            check(not pda_map.valid_layer(a) and not pda_map.valid_layer(b),"released_tokens_invalid")
            out("COMPLETE"); phase=6; start_at=now
        end
    elseif phase==4 and now-start_at>1500 then
        phase=7
        out("SAVE_COMPLETE")
        exec_console_cmd("quit") -- runner cold-loads the saved file in a fresh process
    elseif phase==5 and now-start_at>1800 then
        ActorMenu.get_pda_menu():HideDialog()
        check(pda_map.release_layer(a) and pda_map.release_layer(b),"restored_layers_released")
        out("COMPLETE"); phase=6; start_at=now
    elseif phase==6 and now-start_at>1000 then
        out("CLEAN_QUIT"); exec_console_cmd("quit"); phase=7
    end
end
function on_game_start()
    RegisterScriptCallback("load_state",on_load)
    RegisterScriptCallback("save_state",on_save)
    RegisterScriptCallback("actor_on_first_update",first_update)
    RegisterScriptCallback("actor_on_update",update)
    RegisterScriptCallback("on_pda_map_input",on_input)
    RegisterScriptCallback("on_pda_map_visibility",on_visibility)
    out("REGISTERED")
end
